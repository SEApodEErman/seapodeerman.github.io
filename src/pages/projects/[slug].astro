---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface ProjectView {
  title: string; description: string; category: string; image: ImageMetadata;
  imageAlt: string; role: string; tags: string[];
  href?: string; externalLabel?: string;
  facts: { label: string; value: string }[];
  gallery: { src: string; alt: string; caption: string; width: number; height: number }[];
  relatedPost?: { title: string; href: string };
}
interface Props { entry: CollectionEntry<'projects'> | CollectionEntry<'keyboards'>; project: ProjectView; }
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const paths: { params: { slug: string }; props: Props }[] = projects.map(entry => ({ params: { slug: entry.id }, props: { entry, project: entry.data } }));
  // Keep the existing Kawayo URL; the keyboard collection is its single source.
  const kawayo = (await getCollection('keyboards', ({ data }) => !data.draft)).find(entry => entry.id === 'kawayo');
  if (kawayo) paths.push({
    params: { slug: 'kawayo' },
    props: { entry: kawayo, project: {
      title: kawayo.data.title, description: 'A 65% aluminum board, a brass Toblerone rear weight, and a foamless build with a custom-cut POM plate.',
      category: 'Keyboards', image: kawayo.data.image, imageAlt: kawayo.data.imageAlt,
      role: 'Personal keyboard build', tags: ['65%', 'Kailh BCP', 'POM plate'],
      facts: Object.entries(kawayo.data.specs).map(([label, value]) => ({ label, value })),
      gallery: [], relatedPost: { title: 'See the rest of my current setup', href: '/blog/current-setup/' },
    } },
  });
  return paths;
}
const { entry, project } = Astro.props;
const { Content } = await render(entry);
const related = (await getCollection('projects', ({ data }) => !data.draft)).filter(other => other.id !== entry.id).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const imageWidths = [...new Set([480, 800, 1200, project.image.width])].filter(w => w <= project.image.width);
const backHref = project.category === 'Software' ? '/blog/' : project.category === 'Keyboards' ? '/keyboards/' : '/osu/';
---
<BaseLayout title={project.title + ' | SEApodEErman'} description={project.description} activeHref={backHref}>
  <article class="project-page page-width">
    <a class="back-link" href={backHref}><i class="ph ph-arrow-left" aria-hidden="true"></i>{project.category === 'Keyboards' ? 'The collection' : project.category === 'Software' ? 'Notes & code' : 'Maps & hitsounds'}</a>
    <header class="project-intro">
      <div class="project-title"><p class="eyebrow">{project.category}</p><h1>{project.title}</h1><p class="project-deck">{project.description}</p>
        {project.href && <a class="button button-primary" href={project.href} target="_blank" rel="noopener noreferrer">{project.externalLabel}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>}
        {!project.href && project.relatedPost && <a class="button button-primary" href={project.relatedPost.href}>Read my setup notes<i class="ph ph-arrow-right" aria-hidden="true"></i></a>}
      </div>
      <div class:list={['project-cover', { 'project-cover-contained': project.category === 'Software' || project.category === 'Keyboards' }]}><Image src={project.image} alt={project.imageAlt} widths={imageWidths} sizes="(max-width: 768px) calc(100vw - 40px), 50vw" loading="eager" /></div>
    </header>
    <div class="project-body">
      <div class="project-story"><Content />{project.relatedPost && <a class="text-link" href={project.relatedPost.href}>{project.relatedPost.title}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>}</div>
      <aside class="project-facts" aria-label="Project details"><dl><div><dt>My role</dt><dd>{project.role}</dd></div>{project.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl><ul class="tag-list" aria-label="Project tags">{project.tags.map(tag => <li>{tag}</li>)}</ul></aside>
    </div>
    {project.gallery.length > 0 && <section class="project-gallery" aria-labelledby="gallery-title"><h2 id="gallery-title">Inside the project</h2>{project.gallery.map(picture => <figure><a class="gallery-image-link" href={picture.src} target="_blank" rel="noopener noreferrer" aria-label={'Open full-size image: ' + picture.alt}><Image src={picture.src} alt={picture.alt} width={picture.width} height={picture.height} loading="lazy" /></a><figcaption>{picture.caption}<a href={picture.src} target="_blank" rel="noopener noreferrer">Full size <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></figcaption></figure>)}</section>}
    {entry.id === 'osu-reqtrac' && <p class="project-disclaimer">An independent community project, not affiliated with or endorsed by osu! or ppy.</p>}
    <nav class="related-projects" aria-labelledby="related-title"><h2 id="related-title">More things I’ve made</h2><div class="related-grid">{related.map(other => <a class="related-project" href={'/projects/' + other.id + '/'}><div><span>{other.data.category}</span><h3>{other.data.title}</h3></div><i class="ph ph-arrow-up-right related-arrow" aria-hidden="true"></i></a>)}</div></nav>
  </article>
</BaseLayout>
<style>
  .project-page { padding-block: 48px 100px; }
  .project-intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; padding-block: 40px 72px; }
  .project-title h1 { max-width: 16ch; margin: 18px 0 24px; font-size: clamp(2.5rem, 4.8vw, 4.75rem); line-height: 1.1; letter-spacing: var(--tracking-display); overflow-wrap: anywhere; }
  .project-deck { max-width: 44ch; margin: 0 0 30px; font-size: 1.2rem; line-height: 1.6; color: var(--muted); }
  .project-cover { overflow: hidden; border-radius: var(--radius); background: var(--surface-alt); aspect-ratio: 1.08; }
  .project-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-cover-contained { aspect-ratio: 4 / 3; }
  .project-cover-contained img { object-fit: contain; }
  .project-body { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: clamp(40px, 8vw, 120px); padding-top: 52px; border-top: 1px solid var(--line); }
  .project-story { max-width: 680px; font-family: var(--body); }
  .project-story :global(h2) { margin: 36px 0 18px; font: 700 1.6rem/1.2 var(--sans); letter-spacing: var(--tracking-heading); }
  .project-story :global(h2:first-child) { margin-top: 0; }
  .project-story :global(a) { color: var(--accent); }
  h2 { margin: 0 0 24px; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.15; letter-spacing: var(--tracking-heading); }
  .project-story :global(p) { margin: 0 0 18px; color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
  .project-details { display: grid; gap: 26px; margin: 40px 0 28px; }
  .project-details h3 { margin: 0 0 10px; font-size: 1.2rem; line-height: 1.3; }
  .project-details p { margin: 0; }
  .project-facts { align-self: start; padding: 26px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .project-facts dl { display: grid; gap: 22px; margin: 0 0 28px; }
  .project-facts dt { margin-bottom: 6px; color: var(--muted); font-family: var(--mono); font-size: .75rem; }
  .project-facts dd { margin: 0; line-height: 1.4; font-size: 1rem; }
  .project-gallery { margin-top: 80px; }
  .project-gallery figure { margin: 0 0 40px; }
  .gallery-image-link { display: block; overflow: hidden; background: var(--surface-alt); border: 1px solid var(--line); border-radius: var(--radius); }
  .project-gallery img { display: block; width: 100%; height: auto; }
  .project-gallery figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; color: var(--muted); font-size: .95rem; line-height: 1.5; }
  .project-gallery figcaption a { flex-shrink: 0; color: var(--text); text-underline-offset: 4px; }
  .project-disclaimer { margin-block: 36px; font-size: .9rem; color: var(--muted); }
  .related-projects { margin-top: 80px; padding-top: 40px; border-top: 1px solid var(--line); }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .related-project { display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--text); text-decoration: none; padding-block: 12px; }
  .related-project h3 { margin: 10px 0 0; font-size: clamp(1.2rem, 2vw, 1.6rem); letter-spacing: var(--tracking-card); line-height: 1.25; }
  .related-project div > span { color: var(--muted); font-family: var(--mono); font-size: .75rem; }
  .related-arrow { display: grid; place-items: center; width: 42px; height: 42px; flex-shrink: 0; border-radius: 50%; background: var(--surface-alt); transition: background 180ms ease, color 180ms ease; }
  .related-project:hover .related-arrow { background: var(--accent); color: var(--bg); }
  @media (max-width: 900px) {
    .project-intro { gap: 32px; }
    .project-body { grid-template-columns: minmax(0, 1fr) 250px; gap: 36px; }
  }
  @media (max-width: 768px) {
    .project-page { padding-block: 30px 64px; }
    .project-intro { grid-template-columns: 1fr; padding-block: 30px 44px; gap: 32px; }
    .project-title h1 { max-width: 20ch; font-size: clamp(2.6rem, 8vw, 4rem); }
    .project-deck { max-width: 48ch; font-size: 1.1rem; }
    .project-cover { aspect-ratio: 1.5; }
    .project-cover-contained { aspect-ratio: 4 / 3; }
    .project-body { grid-template-columns: 1fr; gap: 36px; padding-top: 36px; }
    .project-facts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
    .project-gallery, .related-projects { margin-top: 56px; }
    .project-gallery figcaption { flex-direction: column; gap: 5px; }
    .related-grid { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 420px) {
    .project-facts dl { grid-template-columns: 1fr; }
    .project-title .button { font-size: .9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .related-arrow { transition: none; }
  }
</style>
