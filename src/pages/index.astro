---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPoster from '../components/HeroPoster.astro';
import WorkCard from '../components/WorkCard.astro';
import BlogPreview from '../components/BlogPreview.astro';
import KeyboardGallery from '../components/KeyboardGallery.astro';
import { profile, contributions, socialLinks, osuSpotlight } from '../data/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const maps = projects.filter(p => p.data.category !== 'Software');
const spotlight = maps.find(project => project.id === osuSpotlight.projectId);
const selectedMaps = (spotlight ? [spotlight, ...maps.filter(project => project.id !== spotlight.id)] : maps).slice(0, 2);
const software = projects.filter(p => p.data.category === 'Software');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const socialIcons: Record<string, string> = { GitHub: 'ph-github-logo', 'osu! profile': 'ph-circles-three', Email: 'ph-envelope-simple', Twitter: 'ph-x-logo', Discord: 'ph-discord-logo', 'Ko-fi': 'ph-coffee' };
---
<BaseLayout>
  <HeroPoster />
  <section class="section-shell work-section" id="projects" aria-labelledby="work-title">
    <div class="page-width">
      <header class="section-heading"><p class="section-label"><span class="section-index rhythm-index" aria-hidden="true">01</span> Maps & hitsounds</p><h2 id="work-title">Made for the <span class="outline-type">music.</span></h2><p>Selected maps and hitsounds. Small choices, a whole different feeling.</p></header>
      <div class="work-grid work-grid-poster">{selectedMaps.map((project, index) => <WorkCard project={project} index={index} />)}</div>
      <aside class="contribution-summary" id="contributions" aria-label="Tournament contributions">
        <p><i class="ph ph-users-three" aria-hidden="true"></i><span>Custom mapping & QA across <a href="/osu/#contributions">{contributions.length} tournaments</a>.</span></p>
        <a class="text-link" href="/osu/">Explore my osu! work<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </aside>
    </div>
  </section>
  <section class="section-shell keyboard-section" id="setup" aria-labelledby="keyboards-title">
    <div class="page-width">
      <header class="section-heading"><p class="section-label"><span class="section-index keys-index" aria-hidden="true">02</span> On my desk</p><h2 id="keyboards-title">A few of my<br /><span class="outline-type">favourite keys.</span></h2><p>Three builds, three different combinations of parts.</p></header>
      <KeyboardGallery mode="preview" />
      <div class="section-links"><a class="text-link" href="/keyboards/">Photos, stories & build specs<i class="ph ph-arrow-right" aria-hidden="true"></i></a><a class="text-link" href="/blog/current-setup/">The rest of my desk setup<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
    </div>
  </section>
  <section class="section-shell notes-section" id="notes" aria-labelledby="notes-title">
    <div class="page-width">
      <header class="section-heading"><h2 id="notes-title">Outside the <span class="outline-type">editor.</span></h2><p>A little code. A few notes. Things I figured out along the way.</p></header>
      {software.map(project => <article class="software-feature">
        <a class="software-image" href={'/projects/' + project.id + '/'} tabindex="-1" aria-hidden="true"><Image src={project.data.previewImage ?? project.data.image} alt={project.data.previewImageAlt ?? project.data.imageAlt} widths={[480, 800, 1200].filter(width => width <= (project.data.previewImage ?? project.data.image).width)} sizes="(max-width: 767px) calc(100vw - 64px), 55vw" loading="lazy" /></a>
        <div class="software-copy"><span class="work-role">{project.data.role}</span><h3><a href={'/projects/' + project.id + '/'}>{project.data.title}</a></h3><p>{project.data.description}</p><a class="text-link" href={'/projects/' + project.id + '/'}>Inside the project<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
      </article>)}
      <div id="blog" class="latest-notes"><h3>From my notebook</h3><div class="post-list">{posts.map(post => <BlogPreview post={post} />)}</div><a class="text-link" href="/blog/">All notes<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
    </div>
  </section>
  <section class="section-shell about-section" id="about" aria-labelledby="about-title">
    <div class="page-width about-grid">
      <div><span id="hobbies"></span><h2 id="about-title">Same person.<br /><span class="outline-type">Many interests.</span></h2></div>
      <div class="about-copy"><p>I’m <strong>{profile.name}</strong>, or <strong>Mahiru Shiina</strong> in osu!. I make maps, experiment with hitsounds, and help with custom mapping and QA.</p><p>Outside the editor, I’m usually tinkering with a keyboard, working on a software project, or watching anime. I like figuring things out by trying them, then sharing what worked and what didn’t.</p>
        <p><a class="text-link" href="/about/">More about me<i class="ph ph-arrow-right" aria-hidden="true"></i></a></p>
        <nav class="profile-links" id="contact" aria-label="Find me elsewhere">{socialLinks.map(item => <a href={item.href} aria-label={item.label + ': ' + item.handle} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}><i class:list={['ph', socialIcons[item.label] ?? 'ph-link']} aria-hidden="true"></i>{item.label}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</nav>
      </div>
    </div>
  </section>
</BaseLayout>
