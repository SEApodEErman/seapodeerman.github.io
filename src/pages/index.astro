---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SampleDeck from '../components/SampleDeck.astro';
import HobbyCard from '../components/HobbyCard.astro';
import BlogPreview from '../components/BlogPreview.astro';
import { profile, projects, hobbies, socialLinks } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Receipts are derived from the project hrefs (no parallel hardcoded array):
// beatmapset URLs yield `setId · osu/diffId`, GitHub URLs yield a repo ref,
// entries without a link fall back to their tags.
const receiptFor = (project: (typeof projects)[number]): string => {
  const href = project.href ?? '';
  const beat = href.match(/beatmapsets\/(\d+).*?\/(\d+)/);
  if (beat) return `${beat[1]} · osu/${beat[2]}`;
  if (href.includes('github.com')) return href.replace('https://github.com/', 'github · ');
  return project.tags.slice(0, 2).join(' · ') || project.category;
};
---

<BaseLayout>
  <section class="hero page-width" id="top">
    <div class="hero-copy" data-reveal>
      <p class="hero-kicker"><span>osu! mapper</span><span>hitsounder</span><span>keyboards</span></p>
      <h1><span>SEA</span>podEErman</h1>
      <p class="hero-intro">{profile.intro} Also known as <strong>{profile.alias}</strong> — go ahead, press the keys. This page makes noise.</p>
      <div class="hero-deck"><SampleDeck /></div>
      <div class="hero-actions" aria-label="Quick links">
        <a class="button button-primary" href="#projects">Open the shelf <span aria-hidden="true">↓</span></a>
        <a class="button" href="#blog">Read notes <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#contact">Profiles & contact</a>
      </div>
    </div>
    <div class="hero-visual" data-reveal data-reveal-delay="1">
      <div class="portrait-frame">
        <img src={profile.portrait} alt="SEApodEErman's profile avatar" />
        <p><span>profile artwork</span><a href="https://x.com/hanekoto2424" target="_blank" rel="noopener noreferrer">art: @hanekoto2424 ↗</a></p>
      </div>
      <p class="hero-alias-inline">lowkey idk what to add here anymore</p>
      <p class="visual-note">mapping feelings<br />into playable moments</p>
    </div>
  </section>
  <div class="hero-strip" aria-hidden="true">
    <span>beatmaps</span><i>●</i><span>hitsounds</span><i>⌨</i><span>mapping QA</span><i>✦</i><span>custom keyboards</span>
  </div>

  <section class="about section-shell" id="about">
    <div class="page-width">
      <SectionHeading index="01" title="Rhythm in the details." intro="Creative work, careful listening, and a lot of curiosity—both on screen and under the keycaps." />
      <div class="about-grid">
        <div class="about-lead" data-reveal>
          <p>I’m <strong>{profile.name}</strong>, though people in osu! may know me as <strong>{profile.alias}</strong>. For more than four years, I’ve spent a lot of my creative time around beatmaps and hitsounds: listening closely, shaping rhythm into play, and caring about the small choices that make a map feel coherent.</p>
        </div>
        <div class="about-body" data-reveal data-reveal-delay="1">
          <p>I’ve also contributed as a custom mapper for Corsace Closed 2023, Malaysian 5 Digit Amateur Cup, Mekakucity Showdown, and osu! Malaysia Tournament in 2023 and 2024. Tournament mapping appeals to me as a way for me to experience the collaborative process of creating something within a shared vision as well as experimenting with different styles and techniques.</p>
          <p>Away from the editor, I’m a huge custom keyboard nerd. I enjoy the mix of technical choices and personal expression: layout, sound, feel, and all the tiny decisions that turn a keyboard into something distinctly yours. Whether I’m working with rhythm, audio, or keyboards, I’m usually chasing the same thing: a unique way for me to express myself.</p>
        </div>
        <aside class="about-aside" data-reveal data-reveal-delay="2">
          <span aria-hidden="true">“</span>
          <p>Playful on the surface.<br />Thoughtful underneath.</p>
          <div class="mini-timeline"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="projects section-shell" id="projects">
    <div class="page-width">
      <SectionHeading index="02" eyebrow="Project shelf" title="Work worth keeping close." intro="Some stuff I made that I'm proud of." />
      <div>
        {projects.map((project, index) => (
          <article class="spec-row" data-reveal data-reveal-delay={String((index % 3) + 1)}>
            <div class="spec-row-thumb">
              {project.image ? (
                <img src={project.image} alt={`${project.title} cover`} loading="lazy" />
              ) : (
                <span>{project.category}</span>
              )}
            </div>
            <div class="spec-row-body">
              <div class="spec-row-meta"><span class="cat">{project.category}</span><span>{receiptFor(project)}</span></div>
              <h3>
                {project.href ? (
                  <a href={project.href} target="_blank" rel="noopener noreferrer">{project.title} <span aria-hidden="true">↗</span></a>
                ) : (
                  project.title
                )}
              </h3>
              <p>{project.description}</p>
              <ul class="tag-list" aria-label="Project tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <p class="editor-note" data-reveal><span>✦</span> More projects will join the shelf as they are ready to share.</p>
    </div>
  </section>

  <section class="hobbies section-shell" id="hobbies">
    <div class="page-width">
      <SectionHeading index="03" title="A little rhythm. A little circuitry." />
      <div class="hobby-layout">
        <div class="hobby-intro" data-reveal>
          <p>Most of my interests meet somewhere between <em>creative instinct</em> and <em>technical tinkering</em>.</p>
          <div class="osu-detail" aria-hidden="true"><span>100</span><span>50</span><span>300</span></div>
        </div>
        <div class="hobby-grid">{hobbies.map((hobby, index) => <HobbyCard hobby={hobby} index={index} />)}</div>
      </div>
    </div>
  </section>

  <section class="section-shell" id="setup">
    <div class="page-width">
      <SectionHeading index="04" eyebrow="Desk / living inventory" title="The hardware lab." intro="The everyday desk as of July 2026 — PC, ears, and three keyboard build sheets. Full inventory lives in the notes." />
      <div class="bento-grid">
        <div class="bento-cell span-4" data-reveal>
          <span class="k">PC · daily driver</span>
          <h3>Number-cruncher</h3>
          <ul>
            <li><b>R5 5500</b> · 32GB @3200MHz</li>
            <li><b>RTX 5060</b> 8GB GDDR7</li>
            <li><b>VG259QM5A</b> 24.5″ 240Hz</li>
            <li><b>Helios II Pro</b> mouse</li>
          </ul>
        </div>
        <div class="bento-cell span-4" data-reveal data-reveal-delay="1">
          <span class="k">Audio · ears</span>
          <h3>Listening rotation</h3>
          <ul>
            <li><b>SHP9500</b> — desk daily</li>
            <li><b>Aria 2 Red</b> — on the road</li>
            <li><b>May</b> · <b>Wan'er</b> — rotation</li>
          </ul>
        </div>
        <div class="bento-cell span-4 accent" data-reveal data-reveal-delay="2">
          <span class="k">Philosophy</span>
          <h3>Foamless, usually.</h3>
          <ul>
            <li>gummy O-ring vs gasket</li>
            <li>tuned, not stuffed</li>
            <li>sound first, then feel</li>
          </ul>
        </div>
        <div class="bento-cell span-4" data-reveal>
          <span class="k">Neo60 Core · build sheet</span>
          <h3>Foamless alu</h3>
          <ul>
            <li><b>HMX Cosmic Purple</b> switches</li>
            <li>DaYe White-on-Black ABS</li>
            <li>gummy O-ring 90A · foamless</li>
          </ul>
        </div>
        <div class="bento-cell span-4" data-reveal data-reveal-delay="1">
          <span class="k">KBD67 Lite · build sheet</span>
          <h3>Full foam stack</h3>
          <ul>
            <li><b>Keebfront Honeycomb</b> switches</li>
            <li>Aifei Neon ABS</li>
            <li>Margo gasket mod · full foam</li>
          </ul>
        </div>
        <div class="bento-cell span-4 rose" data-reveal data-reveal-delay="2">
          <span class="k">Kawayo · build sheet</span>
          <h3>POM + brass</h3>
          <ul>
            <li><b>Kailh BCP</b> switches</li>
            <li>clone GMK Jamon</li>
            <li>PCBSnap 60A · foamless</li>
          </ul>
        </div>
      </div>
      <p class="editor-note" data-reveal><span>✦</span> <span>Full specs with photos: <a href="/blog/current-setup/">Current setup</a>.</span></p>
    </div>
  </section>

  <section class="blog section-shell" id="blog">
    <div class="page-width">
      <SectionHeading index="05" eyebrow="Notes / blog" title="Thoughts between maps." intro="This is where I share my thoughts and experiences related to osu! mapping, hitsounds, keyboards, and other creative pursuits." />
      <div class="post-list">{posts.map((post, index) => <BlogPreview post={post} index={index} />)}</div>
      <a class="button all-posts" href="/blog/">Browse all notes <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="contact section-shell" id="contact">
    <div class="page-width contact-grid">
      <div data-reveal>
        <p class="contact-label">06 / Say hello</p>
        <h2>Find me<br /><em>around.</em></h2>
        <p class="contact-intro">Find my mapping profile, code, and social accounts below. For project or collaboration inquiries, Discord is the best place to reach me.</p>
      </div>
      <div class="social-list" data-reveal data-reveal-delay="1">
        {socialLinks.map((item, index) => (
          <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={{ placeholder: item.placeholder }} aria-disabled={item.placeholder ? 'true' : undefined}>
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{item.label}</strong><small>{item.handle}</small>
            {item.placeholder ? <i>Placeholder</i> : <b aria-hidden="true">↗</b>}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
