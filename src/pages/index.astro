---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HobbyCard from '../components/HobbyCard.astro';
import BlogPreview from '../components/BlogPreview.astro';
import { profile, projects, hobbies, socialLinks } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero page-width" id="top">
    <div class="hero-copy" data-reveal>
      <p class="hero-kicker"><span>osu!</span><span>keyboards</span></p>
      <h1><span>SEA</span>podEErman</h1>
      <p class="hero-alias"><span>also known as</span> {profile.alias}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions" aria-label="Quick links">
        <a class="button button-primary" href="#projects">See projects <span aria-hidden="true">↓</span></a>
        <a class="button" href="#blog">Read notes <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#contact">Profiles & contact</a>
      </div>
    </div>

    <div class="hero-visual" data-reveal data-parallax style="--delay: 120ms">
      <div class="portrait-frame">
        <img src={profile.portrait} alt="SEApodEErman's profile avatar" />
        <p><span>profile artwork</span><a href="https://x.com/hanekoto2424" target="_blank" rel="noopener noreferrer">art: @hanekoto2424 ↗</a></p>
      </div>
      <div class="key-cluster" aria-hidden="true"><kbd>Z</kbd><kbd>X</kbd><kbd>01</kbd></div>
      <p class="visual-note">mapping feelings<br />into playable moments</p>
    </div>

    <div class="hero-marquee" aria-hidden="true">
      <span>beatmaps</span><i>●</i><span>hitsounds</span><i>⌨</i><span>mapping QA</span><i>✦</i><span>custom keyboards</span>
    </div>
  </section>

  <section class="about section-shell" id="about">
    <div class="page-width">
      <SectionHeading index="01" eyebrow="About me" title="Rhythm in the details." intro="Creative work, careful listening, and a lot of curiosity—both on screen and under the keycaps." />
      <div class="about-grid">
        <div class="about-lead" data-reveal>
          <p>I’m <strong>SEApodEErman</strong>, though people in osu! may know me as <strong>Mahiru Shiina</strong>. For more than four years, I’ve spent a lot of my creative time around beatmaps and hitsounds: listening closely, shaping rhythm into play, and caring about the small choices that make a map feel coherent.</p>
        </div>
        <div class="about-body" data-reveal style="--delay: 80ms">
          <p>I’ve also contributed as a custom mapper for Corsace Closed 2023, Malaysian 5 Digit Amateur Cup, Mekakucity Showdown, and osu! Malaysia Tournament in 2023 and 2024. Tournament mapping appeals to me as a way for me to experience the collaborative process of creating something within a shared vision as well as experimenting with different styles and techniques.</p>
          <p>Away from the editor, I’m a huge custom keyboard nerd. I enjoy the mix of technical choices and personal expression: layout, sound, feel, and all the tiny decisions that turn a keyboard into something distinctly yours. Whether I’m working with rhythm, audio, or keyboards, I’m usually chasing the same thing: a unique way for me to express myself.</p>
        </div>
        <aside class="about-aside" data-reveal style="--delay: 140ms">
          <span aria-hidden="true">“</span>
          <p>Playful on the surface.<br />Thoughtful underneath.</p>
          <div class="mini-timeline"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="projects section-shell" id="projects">
    <div class="page-width">
      <SectionHeading index="02" eyebrow="Project shelf" title="A place for work worth sharing." intro="A growing shelf of maps, sound work, and hardware projects I want to keep close." />
      <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      <p class="editor-note" data-reveal><span>✦</span> More projects will join the shelf as they are ready to share.</p>
    </div>
  </section>

  <section class="hobbies section-shell" id="hobbies">
    <div class="page-width">
      <SectionHeading index="03" eyebrow="Things I gravitate toward" title="A little rhythm. A little circuitry." />
      <div class="hobby-layout">
        <div class="hobby-intro" data-reveal>
          <p>Most of my interests meet somewhere between <em>creative instinct</em> and <em>technical tinkering</em>.</p>
          <div class="osu-detail" aria-hidden="true"><span>100</span><span>50</span><span>300</span></div>
        </div>
        <div class="hobby-grid">{hobbies.map((hobby, index) => <HobbyCard hobby={hobby} index={index} />)}</div>
      </div>
    </div>
  </section>

  <section class="blog section-shell" id="blog">
    <div class="page-width">
      <SectionHeading index="04" eyebrow="Notes / blog" title="Thoughts between maps." intro="This is where I share my thoughts and experiences related to osu! mapping, hitsounds, keyboards, and other creative pursuits." />
      <div class="post-list">{posts.map((post, index) => <BlogPreview post={post} index={index} />)}</div>
      <a class="button all-posts" href="/blog/">Browse all notes <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="contact section-shell" id="contact">
    <div class="page-width contact-grid">
      <div data-reveal>
        <p class="eyebrow">05 / Say hello</p>
        <h2>Find me<br /><em>around.</em></h2>
        <p class="contact-intro">Find my mapping profile, code, and social accounts below. For project or collaboration inquiries, Discord is the best place to reach me.</p>
      </div>
      <div class="social-list" data-reveal style="--delay: 90ms">
        {socialLinks.map((item, index) => (
          <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={{ placeholder: item.placeholder }} aria-disabled={item.placeholder ? 'true' : undefined}>
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{item.label}</strong><small>{item.handle}</small>
            {item.placeholder ? <i>Placeholder</i> : <b aria-hidden="true">↗</b>}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
