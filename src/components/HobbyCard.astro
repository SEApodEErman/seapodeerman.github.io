---
interface Props { hobby: { number: string; title: string; label: string; description: string; symbol: string }; index: number; }
const { hobby, index } = Astro.props;
---
<article class="hobby-card" data-reveal style={`--delay: ${index * 55}ms`}>
  <div class="hobby-top"><span>{hobby.number}</span><span class="hobby-symbol" aria-hidden="true">{hobby.symbol}</span></div>
  <p class="hobby-label">{hobby.label}</p><h3>{hobby.title}</h3><p>{hobby.description}</p>
</article>
