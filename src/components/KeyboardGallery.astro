---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
interface Props { expandableStories?: boolean; mode?: 'collection' | 'preview'; featuredId?: string; }
const { expandableStories = false, mode = 'collection', featuredId = 'kawayo' } = Astro.props;
const builds = (await getCollection('keyboards', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const orderedBuilds = mode === 'preview'
  ? [...builds.filter(entry => entry.id === featuredId), ...builds.filter(entry => entry.id !== featuredId)].slice(0, 3)
  : builds;
const keyboards = await Promise.all(orderedBuilds.map(async entry => ({ entry, ...(await render(entry)) })));
---
<div class:list={['keyboard-gallery', { 'keyboard-gallery-preview': mode === 'preview' }]}>
  {keyboards.map(({ entry, Content }, index) => <article class:list={['keyboard-build', { 'keyboard-featured': mode === 'preview' && index === 0, 'keyboard-compact': mode === 'preview' && index > 0 }]} id={entry.id}>
    <a class="keyboard-photo" href={entry.data.fullImage} data-gallery-image data-name={entry.data.title} data-caption={entry.data.specs.Switches + ' · ' + entry.data.specs.Mount} aria-label={'View full photo of ' + entry.data.title}>
      <Image src={entry.data.image} alt={entry.data.imageAlt} widths={[240, 400, 800, 1200].filter(width => width <= entry.data.image.width)} sizes={mode === 'preview' ? index === 0 ? '(max-width: 767px) calc(100vw - 40px), 55vw' : '(max-width: 767px) calc((100vw - 62px) / 2), (max-width: 1100px) 40vw, 240px' : '(max-width: 767px) calc(100vw - 40px), (max-width: 1280px) calc((100vw - 112px) / 2), 584px'} loading="lazy" />
      <span class="photo-expand" aria-hidden="true"><i class="ph ph-arrows-out"></i></span>
    </a>
    <div class="keyboard-copy">
      {(mode === 'collection' || index === 0) && <span class="build-label">{mode === 'preview' ? 'Featured build' : entry.data.specs.Build}</span>}
      <h3>{entry.data.title}</h3>
      <p class="keyboard-parts">{entry.data.specs.Switches}{(mode === 'collection' || index === 0) && ' · ' + entry.data.specs.Plate + ' plate'}</p>
      {mode === 'preview' ? <>
        {index === 0 && <p class="keyboard-preview-build">{entry.data.specs.Build} · {entry.data.specs.Mount}</p>}
        <a class="text-link keyboard-details-link" href={'/keyboards/#' + entry.id} aria-label={'Build details for ' + entry.data.title}>Build details<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </> : <>
        {expandableStories
          ? <details class="build-story-disclosure"><summary>The story behind {entry.data.title}<i class="ph ph-plus" aria-hidden="true"></i></summary><div class="build-story build-story-expanded"><Content /></div></details>
          : <div class="build-story"><Content /></div>}
        <details class="build-specs"><summary>Build specs<i class="ph ph-plus" aria-hidden="true"></i></summary><dl>{Object.entries(entry.data.specs).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></details>
      </>}
    </div>
  </article>)}
  {keyboards.length === 0 && <p>Another build is on the way. Check back soon.</p>}
</div>
<dialog class="photo-dialog" aria-labelledby="photo-title" aria-describedby="photo-description">
  <div class="photo-toolbar"><p id="photo-title"></p><button class="icon-button" type="button" data-gallery-close aria-label="Close photo"><i class="ph ph-x" aria-hidden="true"></i></button></div>
  <div class="photo-full"><img data-gallery-full alt="" /><p class="photo-error" data-gallery-error hidden>This photo couldn’t load. <a data-gallery-source href="/blog/current-setup/">Open the image directly</a>.</p></div>
  <div class="photo-bottom"><p id="photo-description" aria-live="polite"></p><div class="photo-controls"><button class="icon-button" type="button" data-gallery-prev aria-label="Previous photo"><i class="ph ph-arrow-left" aria-hidden="true"></i></button><span data-gallery-count aria-hidden="true"></span><button class="icon-button" type="button" data-gallery-next aria-label="Next photo"><i class="ph ph-arrow-right" aria-hidden="true"></i></button></div></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-image]')];
  const fullImage = document.querySelector<HTMLImageElement>('[data-gallery-full]');
  const error = document.querySelector<HTMLElement>('[data-gallery-error]');
  let selected = 0;
  const showPhoto = (index: number) => {
    selected = (index + links.length) % links.length;
    const link = links[selected];
    if (!fullImage || !dialog) return;
    if (error) error.hidden = true;
    fullImage.hidden = false;
    fullImage.alt = link.querySelector('img')?.alt ?? link.dataset.name ?? '';
    fullImage.src = link.href;
    dialog.querySelector('[data-gallery-source]')?.setAttribute('href', link.href);
    const title = dialog.querySelector('#photo-title');
    const description = dialog.querySelector('#photo-description');
    const count = dialog.querySelector('[data-gallery-count]');
    if (title) title.textContent = link.dataset.name ?? '';
    if (description) description.textContent = link.dataset.caption ?? '';
    if (count) count.textContent = `${selected + 1} / ${links.length}`;
  };
  if (dialog && typeof dialog.showModal === 'function') {
    links.forEach((link, index) => link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      showPhoto(index);
      dialog.showModal();
    }));
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => showPhoto(selected - 1));
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => showPhoto(selected + 1));
    dialog.addEventListener('click', event => {
      const bounds = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
    });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        showPhoto(selected + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    fullImage?.addEventListener('error', () => {
      fullImage.hidden = true;
      if (error) error.hidden = false;
    });
  }
</script>
<style>
  .keyboard-gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:48px 40px; }
  .keyboard-build { min-width:0; }
  .keyboard-photo { display:block; position:relative; overflow:hidden; border:1px solid var(--line); border-radius:8px; background:var(--surface); box-shadow:0 4px 0 var(--line); }
  .keyboard-photo img { width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform 400ms var(--ease); }
  .keyboard-photo:hover img,.keyboard-photo:focus-visible img { transform:scale(1.025); }
  .photo-expand { position:absolute; right:16px; bottom:16px; display:grid; place-items:center; width:40px; height:40px; border-radius:8px; background:var(--surface); color:var(--text); font-size:20px; }
  .keyboard-copy { padding-top:24px; }
  .keyboard-copy h3 { font-size:34px; line-height:1.2; letter-spacing:var(--tracking-card); margin-bottom:10px; }
  .build-label { display:inline-block; margin-bottom:14px; padding:5px 9px; border:1px solid var(--accent); border-radius:5px; box-shadow:0 2px 0 var(--accent); background:var(--surface); color:var(--accent); font:11px/1.5 var(--mono); }
  .keyboard-parts { color:var(--accent); font:12px/1.7 var(--mono); margin-bottom:18px; }
  .build-story { color:var(--muted); font-size:16px; }
  .build-story :global(p) { margin-bottom:18px; }
  .build-story-disclosure { margin-top:22px; border-top:1px solid var(--line); }
  .build-story-disclosure summary { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-block:16px; list-style:none; cursor:pointer; font-size:15px; font-weight:600; }
  .build-story-disclosure summary::-webkit-details-marker { display:none; }
  .build-story-disclosure summary i { flex-shrink:0; font-size:20px; }
  .build-story-disclosure[open] summary i { transform:rotate(45deg); }
  .build-story-expanded { padding-top:12px; font-family:var(--body); font-size:17px; line-height:1.8; overflow-wrap:anywhere; }
  .build-story-expanded :global(h2),.build-story-expanded :global(h3),.build-story-expanded :global(h4) { margin:1.8em 0 .75em; color:var(--text); font-family:var(--sans); line-height:1.25; letter-spacing:var(--tracking-heading); }
  .build-story-expanded :global(h2) { font-size:26px; }
  .build-story-expanded :global(h3) { font-size:22px; }
  .build-story-expanded :global(h4) { font-size:19px; }
  .build-story-expanded :global(a) { color:var(--accent); }
  .build-story-expanded :global(ul),.build-story-expanded :global(ol) { padding-left:1.4em; margin-bottom:1.2em; }
  .build-story-expanded :global(blockquote) { margin:1.5em 0; padding-left:20px; border-left:3px solid var(--accent); }
  .build-story-expanded :global(img) { border-radius:8px; }
  .build-story-expanded :global(figure) { margin:1.5em 0; }
  .build-story-expanded :global(figcaption) { margin-top:10px; font-size:14px; }
  .build-story-expanded :global(pre),.build-story-expanded :global(table) { max-width:100%; overflow-x:auto; }
  .build-story-expanded :global(pre) { padding:16px; border-radius:8px; background:var(--surface-alt); font:13px/1.7 var(--mono); }
  .build-story-expanded :global(table) { display:block; border-collapse:collapse; }
  .build-story-expanded :global(th),.build-story-expanded :global(td) { padding:10px; border-bottom:1px solid var(--line); text-align:left; }
  .build-story-disclosure+.build-specs { margin-top:0; }
  .build-specs { border-top:1px solid var(--line); margin-top:22px; }
  .build-specs summary { display:flex; align-items:center; justify-content:space-between; padding-block:16px; list-style:none; cursor:pointer; font-size:15px; font-weight:600; }
  .build-specs summary::-webkit-details-marker { display:none; }
  .build-specs summary i { font-size:20px; }
  .build-specs[open] summary i { transform:rotate(45deg); }
  .build-specs dl { display:grid; gap:12px; margin:4px 0 12px; }
  .build-specs dl>div { display:grid; grid-template-columns:100px minmax(0,1fr); gap:16px; }
  .build-specs dt { color:var(--muted); font:11px/1.8 var(--mono); }
  .build-specs dd { margin:0; font-size:14px; }
  .keyboard-gallery:not(.keyboard-gallery-preview) .keyboard-build:last-child:nth-child(odd) { grid-column:1/-1; display:grid; grid-template-columns:1.1fr 1fr; align-items:center; gap:48px; }
  .keyboard-gallery:not(.keyboard-gallery-preview) .keyboard-build:last-child:nth-child(odd) .keyboard-copy { padding-top:0; }
  .keyboard-gallery-preview { grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); align-items:start; gap:28px 40px; }
  .keyboard-featured { grid-row:span 2; }
  .keyboard-featured .keyboard-photo img { aspect-ratio:16/10; object-fit:contain; background:#fff; }
  .keyboard-preview-build { color:var(--muted); margin:0 0 16px; font-size:15px; }
  .keyboard-details-link { font-size:14px; min-height:24px; }
  .keyboard-compact { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-self:stretch; align-items:center; gap:20px; padding:20px; border:1px solid var(--line); border-radius:8px; box-shadow:0 4px 0 var(--line); background:var(--surface); }
  .keyboard-compact .keyboard-copy { min-width:0; padding-top:0; }
  .keyboard-compact h3 { font-size:24px; }
  .keyboard-compact .keyboard-parts { font-size:11px; margin-bottom:10px; }
  .keyboard-compact .photo-expand { width:28px; height:28px; right:6px; bottom:6px; font-size:17px; }
  @media(min-width:768px) and (max-width:1100px) {
    .keyboard-gallery-preview { gap:24px; }
    .keyboard-compact { grid-template-columns:1fr; gap:18px; padding:16px; }
  }
  .photo-dialog { width:min(1080px,calc(100% - 40px)); max-height:calc(100dvh - 40px); padding:20px; border:1px solid var(--line); border-radius:var(--radius); background:var(--bg); color:var(--text); }
  .photo-dialog::backdrop { background:rgb(10 24 40 / .85); }
  .photo-toolbar,.photo-bottom { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .photo-toolbar { margin-bottom:16px; }
  .photo-toolbar p { margin:0; font-weight:700; font-size:23px; }
  .photo-full { background:var(--surface-alt); border-radius:8px; overflow:hidden; min-height:160px; }
  .photo-full img { width:100%; max-height:calc(100dvh - 230px); object-fit:contain; }
  .photo-error { margin:0; padding:40px 24px; }
  .photo-bottom { margin-top:16px; }
  .photo-bottom>p { font-size:15px; color:var(--muted); margin:0; }
  .photo-controls { display:flex; align-items:center; gap:14px; flex-shrink:0; }
  .photo-controls>span { font:12px var(--mono); color:var(--muted); }
  @media(max-width:767px) {
    .keyboard-gallery { grid-template-columns:1fr; gap:38px; }
    .keyboard-gallery:not(.keyboard-gallery-preview) .keyboard-build:last-child:nth-child(odd) { display:block; }
    .keyboard-gallery:not(.keyboard-gallery-preview) .keyboard-build:last-child:nth-child(odd) .keyboard-copy { padding-top:22px; }
    .keyboard-copy { padding-top:22px; }
    .keyboard-copy h3 { font-size:30px; }
    .keyboard-gallery-preview { grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px 20px; }
    .keyboard-featured { grid-column:1/-1; grid-row:auto; }
    .keyboard-featured .keyboard-photo img { aspect-ratio:4/3; }
    .keyboard-compact { display:block; padding:0; border:0; box-shadow:none; background:transparent; }
    .keyboard-compact .keyboard-copy { padding-top:16px; }
    .keyboard-compact h3 { font-size:22px; }
    .keyboard-compact .keyboard-details-link { font-size:13px; min-height:32px; }
    .photo-dialog { width:calc(100% - 24px); padding:14px; }
    .photo-bottom { flex-direction:column; align-items:flex-start; gap:14px; }
    .photo-controls { align-self:flex-end; }
    .photo-toolbar p { font-size:21px; }
    .photo-full img { max-height:calc(100dvh - 280px); }
  }
  @media(prefers-reduced-motion:reduce) {
    .keyboard-photo:hover img,.keyboard-photo:focus-visible img { transform:none; }
  }
</style>
