---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index } = Astro.props;
const p = project.data;
const widths = [...new Set([160, 320, 480, 800, 1200, p.image.width])].filter(w => w <= p.image.width);
const sizes = index === 1
  ? '(max-width: 767px) calc(35vw - 28px), (max-width: 1280px) 44vw, 540px'
  : '(max-width: 767px) calc(100vw - 48px), (max-width: 1280px) 55vw, 680px';
const [artist, ...song] = p.title.split(' / ');
const title = song.length ? song.join(' / ') : p.title;
const externalLabel = p.category === 'Software' ? p.externalLabel : 'Open beatmap on osu!';
---
<article class="work-card">
  <div class="work-art">
    <a class="work-cover" href={'/projects/' + project.id + '/'} tabindex="-1" aria-hidden="true"><Image src={p.image} alt={p.imageAlt} widths={widths} sizes={sizes} loading="lazy" /></a>
    {index !== undefined && <span class="work-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="work-caption">
    {song.length > 0 && <p class="work-artist">{artist}</p>}
    <h3><a href={'/projects/' + project.id + '/'} aria-label={p.title}>{title}</a></h3>
    <span class="work-role">{p.role}</span><p class="work-description">{p.description}</p>
    <div class="work-links"><a class="text-link" href={p.href} target="_blank" rel="noopener noreferrer">{externalLabel}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a><a class="work-story-link" href={'/projects/' + project.id + '/'}>Project notes<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
  </div>
</article>
