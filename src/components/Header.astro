---
import { navigation } from '../data/site';
---

<header class="site-header">
  <div class="header-inner page-width">
    <a class="wordmark" href="/#top" aria-label="SEApodEErman home">
      <span>SEApodEErman</span>
    </a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span class="sr-only">Open menu</span>
    </button>
    <nav id="site-nav" class="site-nav" data-nav aria-label="Main navigation">
      {navigation.map((item) => <a href={`/${item.href}`}>{item.label}</a>)}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <span class="theme-icon" aria-hidden="true"><span></span></span>
      <span class="theme-text">Theme</span>
    </button>
  </div>
</header>
