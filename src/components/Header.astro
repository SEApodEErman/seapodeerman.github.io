---
import { navigation } from '../data/site';
import BrandMark from './BrandMark.astro';
interface Props { activeHref?: string; }
const { activeHref } = Astro.props;
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner page-width">
    <a class="wordmark" href="/"><BrandMark /><span>SEApodEErman<span class="brand-alias">Mahiru Shiina</span></span></a>
    <nav class="site-nav" id="site-nav" data-nav aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href} aria-current={pathname === item.href ? 'page' : pathname.startsWith(item.href) || activeHref === item.href ? 'location' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-controls">
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" hidden><i class="ph ph-sun light-icon" aria-hidden="true"></i><i class="ph ph-moon dark-icon" aria-hidden="true"></i></button>
      <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation" hidden><i class="ph ph-list" aria-hidden="true"></i></button>
    </div>
  </div>
</header>
