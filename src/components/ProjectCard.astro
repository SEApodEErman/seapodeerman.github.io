---
interface Props {
  project: { title: string; description: string; category: string; image: string; href?: string; tags: string[]; placeholder?: boolean };
  index: number;
}
const { project, index } = Astro.props;
const isExternal = project.href?.startsWith('http') ?? false;
---
<article class="project-card" data-reveal style={`--delay: ${index * 80}ms`}>
  {project.href ? (
    <a class="project-image" href={project.href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined} aria-label={`${project.title}${project.placeholder ? ' — placeholder' : ''}`}>
      <img src={project.image} alt="" loading="lazy" /><span class="project-arrow" aria-hidden="true">↗</span>
    </a>
  ) : (
    <div class="project-image"><img src={project.image} alt="" loading="lazy" /></div>
  )}
  <div class="project-meta"><p>{String(index + 1).padStart(2, '0')} / {project.category}</p>{project.placeholder && <span>Sample</span>}</div>
  <h3>{project.href ? <a href={project.href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>{project.title}</a> : project.title}</h3>
  <p>{project.description}</p>
  <ul class="tag-list" aria-label="Tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
</article>
