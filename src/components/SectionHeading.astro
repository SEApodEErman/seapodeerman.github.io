---
interface Props { index: string; eyebrow?: string; title: string; intro?: string; }
const { index, eyebrow, title, intro } = Astro.props;
---
<header class="section-heading" data-reveal>
  <div class="section-index">{index}</div>
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{intro && <p class="section-intro">{intro}</p>}</div>
</header>
